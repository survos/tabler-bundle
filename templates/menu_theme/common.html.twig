{#
 # @SurvosTabler/menu_theme/common.html.twig: Tabler pieces every slot theme shares (survos/menu-bundle themes).
 # Sits just above @SurvosMenu/theme/base.html.twig in each slot's stack; see TablerMenuSpecs.
 #
 # Set `icon_class` before block('icon') to size an icon for its place.
 #}

{%- block icon -%}
{#- the trailing space separates the icon from its label, as the knp templates' whitespace did -#}
{%- if item.icon %}{{ ux_icon(':' in item.icon ? item.icon : 'tabler:' ~ item.icon, {class: icon_class|default('icon')}) }}{{ item.label is not empty ? ' ' }}{% endif -%}
{%- endblock -%}

{%- block badge -%}
{%- if item.badge %}<span class="badge badge-sm bg-{{ item.badge.color ?? 'green' }}-lt text-uppercase ms-auto">{{ item.badge.value }}</span>{% endif -%}
{%- endblock -%}

{# A dropdown's panel and its entries: navbar, navbar tools, sidebar and the user menu all draw them alike. #}
{%- block submenu -%}
<div class="dropdown-menu{{ options.dropdownMenuClass is defined ? ' ' ~ options.dropdownMenuClass }}">
    {%- for item in item.children %}{{ block('dropdown_item') }}{% endfor -%}
</div>
{%- endblock -%}

{%- block dropdown_item -%}{{ block('dropdown_' ~ item.kind.value) }}{%- endblock -%}

{%- block dropdown_link -%}
{%- set icon_class = 'icon dropdown-item-icon' -%}
<a{{ menu_attrs(item.linkAttributes, {class: ['dropdown-item', item.current ? 'active'], href: item.uri, title: item.tooltip}) }}>{{ block('icon') }}{{ block('label') }}{{ block('badge') }}</a>
{%- endblock -%}

{%- block dropdown_submenu -%}
{%- set icon_class = 'icon dropdown-item-icon' -%}
<div{{ menu_attrs(item.attributes, {class: 'dropend'}) }}>
    <a{{ menu_attrs(item.linkAttributes, {class: 'dropdown-item dropdown-toggle', href: '#', 'data-bs-toggle': 'dropdown', 'data-bs-auto-close': options.dropdownAutoClose ?? 'outside', role: 'button', 'aria-expanded': 'false'}) }}>{{ block('icon') }}{{ block('label') }}</a>
    {{- block('submenu') -}}
</div>
{%- endblock -%}

{%- block dropdown_heading -%}<h6 class="dropdown-header">{{ block('label') }}</h6>{%- endblock -%}

{%- block dropdown_divider -%}<div class="dropdown-divider"></div>{%- endblock -%}

{%- block dropdown_search -%}<div class="px-3 py-1">{{ block('search_form') }}</div>{%- endblock -%}

{%- block item_divider -%}<li class="nav-item"><div class="vr mx-2"></div></li>{%- endblock -%}

{%- block item_heading -%}<li class="nav-item"><span class="nav-link disabled">{{ block('label') }}</span></li>{%- endblock -%}

{%- block search_form -%}
{%- set field = item.extra('name', 'q') -%}
<form method="get" action="{{ item.uri }}" role="search" class="d-none d-md-block ms-2">
    <input{{ menu_attrs(item.linkAttributes, {class: 'form-control form-control-sm', type: 'search', name: field, value: app.request.query.get(field) ?? '', placeholder: item.label, 'aria-label': item.label, autocomplete: 'off'}) }}>
</form>
{%- endblock -%}

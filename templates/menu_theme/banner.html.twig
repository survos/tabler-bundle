{# @SurvosTabler/menu_theme/banner.html.twig: BANNER, one line of text links #}

{%- block menu -%}{% for item in menu.children %}{{ block('item') }}{{ not loop.last ? ' ' }}{% endfor %}{%- endblock -%}

{%- block item_link -%}
<a{{ menu_attrs(item.linkAttributes, {class: 'tblr-banner-text', href: item.uri}) }}>{{ block('label') }}</a>
{%- endblock -%}

{# one line of text: a heading is plain text, a group contributes its links #}
{%- block item_heading -%}<span class="tblr-banner-text">{{ block('label') }}</span>{%- endblock -%}
{%- block item_submenu -%}{% for item in item.children %}{{ block('item') }}{{ not loop.last ? ' ' }}{% endfor %}{%- endblock -%}
{%- block item_divider -%}{%- endblock -%}
